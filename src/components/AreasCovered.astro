---
import { business } from "../data/business";
---

<section class="section areas">
  <div class="wrap">
    <h2>Across <em>{business.region}</em></h2>
    <p class="areas__towns tabular">
      {business.areas.map((town, i) => (
        <>
          <span>{town}</span>
          {i < business.areas.length - 1 && <span class="areas__dot" aria-hidden="true">·</span>}
        </>
      ))}
    </p>
    <p class="areas__note">
      Collect from {business.collectionTown}, or we'll deliver anywhere in {business.region} —
      delivery is quoted separately.
    </p>
  </div>
</section>

<style>
  .areas__towns {
    margin-top: var(--space-3);
    font-size: 1.0625rem;
    line-height: 1.9;
  }

  .areas__dot {
    margin: 0 0.5em;
    color: var(--wood);
  }

  .areas__note {
    margin-top: var(--space-3);
    color: var(--ink-muted);
    max-width: 34rem;
  }
</style>
