---
import { business } from "../data/business";

const { chairPrice, tablePrice, fullSetPrice, currencySymbol } = business.pricing;
---

<div class="rate-card">
  <p class="rate-card__label small-caps">Rates</p>
  <ul class="rate-card__list tabular">
    <li>
      <span>Chiavari chair</span>
      <span class="rate-card__leader" aria-hidden="true"></span>
      <span>{currencySymbol}{chairPrice}</span>
    </li>
    <li>
      <span>6ft table</span>
      <span class="rate-card__leader" aria-hidden="true"></span>
      <span>{currencySymbol}{tablePrice}</span>
    </li>
    <li class="rate-card__full">
      <span>Full set — {business.stock.maxChairs} chairs + {business.stock.maxTables} tables</span>
      <span class="rate-card__leader" aria-hidden="true"></span>
      <span>{currencySymbol}{fullSetPrice}</span>
    </li>
  </ul>
  <p class="rate-card__note">
    1–{business.hire.maxStandardDays} day hire. Delivery &amp; collection quoted separately.
  </p>
</div>

<style>
  .rate-card {
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: var(--space-3);
    background: var(--paper);
    max-width: 28rem;
  }

  .rate-card__label {
    margin-bottom: var(--space-2);
  }

  .rate-card__list li {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    padding: 0.4em 0;
    font-size: 1.0625rem;
  }

  .rate-card__full {
    border-top: 1px dashed var(--rule);
    margin-top: 0.3em;
    padding-top: 0.6em !important;
    font-weight: 600;
  }

  .rate-card__leader {
    flex: 1 1 auto;
    border-bottom: 1px dotted var(--rule);
    height: 0;
    transform: translateY(-0.35em);
  }

  .rate-card__note {
    margin-top: var(--space-2);
    font-size: 0.8125rem;
    color: var(--ink-muted);
  }
</style>
