---
import { business } from "../data/business";
import CallIcon from "./CallIcon.astro";
---

<header class="header">
  <div class="wrap header__inner">
    <a href="/" class="header__mark">{business.name}</a>
    <div class="header__actions">
      <a href={business.phoneHref} class="header__call" aria-label={`Call ${business.phoneDisplay}`} title={business.phoneDisplay}>
        <CallIcon class="header__call-icon" />
      </a>
      <a href="/book" class="btn btn--primary header__book">Book your chairs</a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
  }

  .header__mark {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .header__call {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    color: var(--ink);
  }

  .header__call:hover {
    border-color: var(--ink);
    color: var(--accent-text);
  }

  .header__call-icon {
    width: 1.125rem;
    height: 1.125rem;
  }

  .header__book {
    padding: 0.6em 1.2em;
    font-size: 0.9375rem;
  }

  @media (max-width: 36rem) {
    .header__book {
      padding: 0.55em 1em;
    }
  }
</style>
