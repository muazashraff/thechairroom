---
// A simple desk-bell mark for "call us" — deliberately not the generic
// phone-handset glyph.
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d="M12 5v2" />
  <circle cx="12" cy="4" r="0.9" fill="currentColor" stroke="none" />
  <path d="M6 16.5C6 11.3 8.2 7 12 7s6 4.3 6 9.5" />
  <path d="M4.5 16.5h15" />
  <path d="M10.3 16.5a1.7 1.7 0 0 0 3.4 0" />
</svg>
