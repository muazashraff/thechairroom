---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { business } from "../data/business";
---

<BaseLayout title={`Page not found | ${business.name}`} description="That page doesn't exist." path="/404">
  <Header />
  <main id="main">
    <section class="section not-found">
      <div class="wrap">
        <p class="small-caps eyebrow">404</p>
        <h1>That page isn't here.</h1>
        <p class="not-found__lede">
          The page you're looking for doesn't exist. Head back to the homepage or go straight to booking.
        </p>
        <div class="not-found__actions">
          <a href="/" class="btn btn--primary">Back home</a>
          <a href="/book" class="text-link">Book your chairs</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .not-found {
    min-height: 50vh;
  }

  .not-found__lede {
    margin-top: var(--space-2);
    color: var(--ink-muted);
    max-width: 30rem;
  }

  .not-found__actions {
    margin-top: var(--space-3);
    display: flex;
    gap: var(--space-3);
    align-items: center;
  }
</style>
