---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BookingForm from "../components/BookingForm.astro";
import { business } from "../data/business";
---

<BaseLayout title={business.seo.titleBook} description={business.seo.descriptionBook} path="/book">
  <Header />
  <main id="main">
    <section class="section book-intro">
      <div class="wrap">
        <h1>Book your chairs</h1>
        <p class="book-intro__lede">
          Fill this in and your request opens in WhatsApp, ready to send.
        </p>
      </div>
    </section>
    <section class="section book-form-section">
      <div class="wrap">
        <BookingForm />
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .book-intro {
    padding-bottom: 0;
  }

  .book-intro__lede {
    margin-top: var(--space-2);
    color: var(--ink-muted);
    max-width: 32rem;
  }

  .book-form-section {
    padding-top: var(--space-4);
  }
</style>
